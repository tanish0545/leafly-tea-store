# Leafly Environment Variables (Template)

# ─── FRONTEND CLIENT VARIABLES (Vite / Public) ──────────────────────────────────
# Exposed to client bundle. NEVER put private keys, secrets, or service accounts here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=leafly-database.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=leafly-database
VITE_FIREBASE_STORAGE_BUCKET=leafly-database.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ADMIN_EMAIL=leaflydatabase@gmail.com

# Cashfree Public Environment ("sandbox" or "production")
VITE_CASHFREE_ENV=sandbox

# Local Emulator Support (set to true to use Firebase Emulator Suite)
VITE_USE_FIREBASE_EMULATOR=false

# ─── SERVER-ONLY VARIABLES (Never use VITE_ prefix) ─────────────────────────────
# Add these to Vercel: Project → Settings → Environment Variables
# For local dev: Keep in .env (never commit .env to Git)

# Cashfree Payments Gateway (Server-Side)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Firebase Admin Service Account (Server-Side Order Status Updates)
# Download from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=leafly-database
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@leafly-database.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Delivery (Gmail SMTP — Production & Staging)
# Requirements:
# 1. Enable 2-Step Verification on the Leafly Google Account (https://support.google.com/mail/answer/185833).
# 2. Generate a 16-character Google App Password: https://myaccount.google.com/apppasswords
# 3. Add to Vercel/production backend: Project → Settings → Environment Variables
# 4. Spaces in the 16-digit password (e.g. "abcd efgh ijkl mnop") are automatically trimmed.
GMAIL_USER=leaflydatabase@gmail.com
GMAIL_APP_PASSWORD=rkkv wryy bzmi gfgm
# Admin notification email for orders, inquiries, gifting & newsletter alerts (defaults to myleaflytea@gmail.com):
ADMIN_NOTIFICATION_EMAIL=leaflydatabase@gmail.com
# Secret key for authorized testing via /api/test-email:
ADMIN_SECRET=leafly-admin-secret-key
