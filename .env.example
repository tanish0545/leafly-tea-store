# Leafly Environment Variables (Template)

# ─── FRONTEND CLIENT VARIABLES (Vite / Public) ──────────────────────────────────
# Exposed to client bundle. NEVER put private keys, secrets, or service accounts here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=leafly-database.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=leafly-database
VITE_FIREBASE_STORAGE_BUCKET=leafly-database.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ADMIN_EMAIL=leaflydatabase@gmail.com

# Cashfree Public Environment ("sandbox" or "production")
VITE_CASHFREE_ENV=sandbox

# Local Emulator Support (set to true to use Firebase Emulator Suite)
VITE_USE_FIREBASE_EMULATOR=false

# ─── SERVER-ONLY VARIABLES (Never use VITE_ prefix) ─────────────────────────────
# Add these to Vercel: Project → Settings → Environment Variables
# For local dev: Keep in .env (never commit .env to Git)

# Cashfree Payments Gateway (Server-Side)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Firebase Admin Service Account (Server-Side Order Status Updates)
# Download from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=leafly-database
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@leafly-database.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Delivery (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=leaflydatabase@gmail.com
