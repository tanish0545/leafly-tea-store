rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Schemas
    // ===============================================================
    //
    // Collection: reviews
    // Document ID: {reviewId}
    // Fields:
    //   - id: string (optional) - Unique identifier for review
    //   - productId: string (required, 1-100 chars, immutable on customer update) - Catalog product ID
    //   - productName: string (optional) - Product name
    //   - productSlug: string (optional) - Product URL slug
    //   - rating: number or int (required, 1 <= rating <= 5) - Star rating score
    //   - feedback: string (required, 5-2000 chars) - Customer tasting review notes
    //   - customerName: string (required, 2-80 chars) - Customer display name
    //   - customerEmail: string (optional) - Customer email
    //   - userId: string or null (optional, immutable on customer update) - Creator UID
    //   - isVerified: bool (optional, immutable on customer update) - Verified buyer badge (orderId required if guest)
    //   - orderId: string (optional) - Associated purchase order reference
    //   - status: string (optional, e.g. "Approved" | "Hidden") - Moderation status (admin managed)
    //   - createdAt: string or timestamp (optional) - Review creation time
    //   - updatedAt: string or timestamp (optional) - Review update time
    //   - timestamp: timestamp (optional) - Server timestamp
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID)
    //
    // Collection: orders
    // Document ID: {orderId}
    //
    // Collection: products
    // Document ID: {productId}
    //
    // Collection: coupons
    // Document ID: {couponId}
    //
    // Collection: teaware
    // Document ID: {itemId}
    //
    // Collection: hampers
    // Document ID: {hamperId}
    //
    // Collection: subscribers
    // Document ID: {subscriberId}
    //
    // Collection: gifting_requests
    // Document ID: {requestId}
    //
    // Collection: contact_messages
    // Document ID: {messageId}
    //
    // Collection: requests
    // Document ID: {requestId}
    //
    // Collection: mail
    // Document ID: {mailId}
    //
    // Collection: system
    // Document ID: {docId}
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'leaflydatabase@gmail.com' ||
          request.auth.token.email.lower() == 'leaflydatabase@gmail.com' ||
          request.auth.token.email == 'admin@leafly.com' ||
          request.auth.token.email.lower() == 'admin@leafly.com' ||
          request.auth.token.email == 'admin@leaflytea.com' ||
          request.auth.token.email.lower() == 'admin@leaflytea.com'
        )) ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('isAdmin', false) == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ))
      );
    }

    // Domain Validator for reviews
    function isValidReview(data) {
      return (data.rating is int || data.rating is number) &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.productId is string &&
        data.productId.size() > 0 &&
        data.productId.size() <= 100 &&
        data.feedback is string &&
        data.feedback.size() >= 5 &&
        data.feedback.size() <= 2000 &&
        data.customerName is string &&
        data.customerName.size() >= 2 &&
        data.customerName.size() <= 80;
    }

    // 1. Users collection:
    // Authenticated users can read and write only their own document.
    // Authorized Admins can read all customer accounts.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 1b. Deleted accounts audit collection:
    // Customers can create/update their own audit record upon deletion.
    // Authorized Admins can read and audit all deleted accounts.
    match /deleted_accounts/{userId} {
      allow read: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Orders collection:
    // Customers can create orders (authenticated or guest with valid fields).
    // Customers can read their own orders and cancel them.
    // Authorized Admins have full access.
    match /orders/{orderId} {
      allow create: if (
        isAuthenticated() && (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('customerId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid ||
          request.resource.data.get('userUid', '') == request.auth.uid ||
          (request.resource.data.get('customerEmail', '') != '' && request.auth.token.email != null && (
            request.resource.data.customerEmail == request.auth.token.email ||
            request.resource.data.customerEmail.lower() == request.auth.token.email.lower()
          )) ||
          isAdmin()
        )
      ) || (
        request.resource.data.customerEmail is string &&
        request.resource.data.customerEmail.size() > 3 &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        (request.resource.data.get('isGuest', false) == true || request.resource.data.get('userId', '') == 'guest')
      );
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        resource.data.get('userUid', '') == request.auth.uid ||
        (resource.data.get('customerEmail', '') != '' && request.auth.token.email != null && (
          resource.data.customerEmail == request.auth.token.email ||
          resource.data.customerEmail.lower() == request.auth.token.email.lower()
        )) ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('customerId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('userUid', '') == request.auth.uid ||
          (resource.data.get('customerEmail', '') != '' && request.auth.token.email != null && (
            resource.data.customerEmail == request.auth.token.email ||
            resource.data.customerEmail.lower() == request.auth.token.email.lower()
          ))
        ) && (
          // Only eligible non-cancelled, non-delivered orders can be cancelled
          resource.data.get('status', '') != 'Cancelled' &&
          resource.data.get('orderStatus', '') != 'Cancelled' &&
          resource.data.get('status', '') != 'Delivered' &&
          resource.data.get('orderStatus', '') != 'Delivered'
        ) && (
          // Customer can ONLY cancel their own order
          // Payment confirmation fields (paymentStatus, paymentId, cfPaymentId) and confirmed orderStatus
          // can NEVER be modified directly by customers — only by trusted server verification.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderStatus', 'updatedAt']) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderStatus', 'inventoryRestored', 'updatedAt'])
          ) &&
          request.resource.data.status == 'Cancelled' &&
          request.resource.data.orderStatus == 'Cancelled'
        )
      );
      allow delete: if isAdmin();
    }

    // 3. Products collection:
    // Publicly readable. Admin has full write access.
    // Customers can decrement stock & inStock when an order is placed.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock']);
    }

    // 4. Coupons collection:
    // Publicly readable for checkout validation. Admin only for creation/editing.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Teaware collection:
    // Publicly readable. Admin has full write access.
    // Customers can decrement stock & inStock during checkout when purchased.
    match /teaware/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock']);
    }

    // 6. Hampers collection:
    // Publicly readable. Admin has full write access.
    // Customers can decrement stock & inStock during checkout.
    match /hampers/{hamperId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock']);
    }

    // 7. Reviews collection:
    // Globally readable so all visitors, customers, and guests across all devices and sessions can read public reviews and rating stats without permission-denied errors.
    // Customers (both authenticated and guests) can submit genuine reviews with strict field validation.
    // Authors can update their own feedback/rating or delete their own review (userId and productId remain immutable; verified status and moderation status protected).
    // Authorized Admins have full moderation rights (e.g. toggling status between Approved and Hidden) and delete permissions.
    match /reviews/{reviewId} {
      // 1. Public Global Reads
      allow read: if true;

      // 2. Review Creation & Validation
      allow create: if isValidReview(request.resource.data) &&
        // Prevent user impersonation:
        // If unauthenticated: userId must be null or empty string.
        // If authenticated: if userId is present, it must equal request.auth.uid.
        (request.auth == null
          ? (request.resource.data.get('userId', null) == null || request.resource.data.get('userId', '') == '')
          : (request.resource.data.get('userId', null) == null || request.resource.data.get('userId', '') == '' || request.resource.data.get('userId', '') == request.auth.uid)) &&
        // Prevent verified purchase spoofing: guests cannot mark isVerified == true without an order reference
        (request.auth == null
          ? (request.resource.data.get('isVerified', false) == false || (request.resource.data.get('orderId', '') != '' && request.resource.data.orderId is string))
          : true);

      // 3. Review Ownership & Updates
      allow update: if isAdmin() || (
        // The author of a review can update their own review feedback/rating
        resource.data.get('userId', null) != null &&
        isOwner(resource.data.userId) &&
        // Validate updated review feedback & rating
        isValidReview(request.resource.data) &&
        // In customer updates, the author cannot change userId or productId
        request.resource.data.get('userId', null) == resource.data.get('userId', null) &&
        request.resource.data.productId == resource.data.productId &&
        // Prevent customer privilege escalation or moderation bypass (cannot modify userId, productId, isVerified, or status)
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'productId', 'isVerified', 'status'])
      );

      // 4. Review Deletes
      allow delete: if isAdmin() || (
        resource.data.get('userId', null) != null &&
        isOwner(resource.data.userId)
      );
    }

    // 8. Newsletter Subscribers:
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 9. Gifting Requests:
    match /gifting_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 10. Contact Inquiries:
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 10b. Unified Customer Requests (Contact, Gifting, Concierge Inquiries):
    match /requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 11. Firebase Trigger Email extension queue:
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 12. System metadata (catalog metadata for permanently deleted items):
    // Publicly readable so customer catalog knows deleted items. Admin has full write access.
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
