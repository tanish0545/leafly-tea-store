rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'leaflydatabase@gmail.com' ||
          request.auth.token.email.lower() == 'leaflydatabase@gmail.com' ||
          request.auth.token.email == 'admin@leafly.com' ||
          request.auth.token.email.lower() == 'admin@leafly.com' ||
          request.auth.token.email == 'admin@leaflytea.com' ||
          request.auth.token.email.lower() == 'admin@leaflytea.com'
        )) ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('isAdmin', false) == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ))
      );
    }

    // 1. Users collection:
    // Authenticated users can read and write only their own document.
    // Authorized Admins can read all customer accounts.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 1b. Deleted accounts audit collection:
    // Customers can create/update their own audit record upon deletion.
    // Authorized Admins can read and audit all deleted accounts.
    match /deleted_accounts/{userId} {
      allow read: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Orders collection:
    // Customers can only create orders that correspond to their authenticated identity.
    // Customers can read their own orders and cancel them.
    // Authorized Admins have full access.
    match /orders/{orderId} {
      allow create: if isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('customerId', '') == request.auth.uid ||
        request.resource.data.get('uid', '') == request.auth.uid ||
        request.resource.data.get('userUid', '') == request.auth.uid ||
        (request.resource.data.get('customerEmail', '') != '' && request.auth.token.email != null && (
          request.resource.data.customerEmail == request.auth.token.email ||
          request.resource.data.customerEmail.lower() == request.auth.token.email.lower()
        )) ||
        isAdmin()
      );
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        resource.data.get('userUid', '') == request.auth.uid ||
        (resource.data.get('customerEmail', '') != '' && request.auth.token.email != null && (
          resource.data.customerEmail == request.auth.token.email ||
          resource.data.customerEmail.lower() == request.auth.token.email.lower()
        )) ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('customerId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('userUid', '') == request.auth.uid ||
          (resource.data.get('customerEmail', '') != '' && request.auth.token.email != null && (
            resource.data.customerEmail == request.auth.token.email ||
            resource.data.customerEmail.lower() == request.auth.token.email.lower()
          ))
        ) && (
          // Only eligible non-cancelled, non-delivered orders can be cancelled
          resource.data.get('status', '') != 'Cancelled' &&
          resource.data.get('orderStatus', '') != 'Cancelled' &&
          resource.data.get('status', '') != 'Delivered' &&
          resource.data.get('orderStatus', '') != 'Delivered'
        ) && (
          // Customer can ONLY cancel their own order
          // Payment confirmation fields (paymentStatus, paymentId, cfPaymentId) and confirmed orderStatus
          // can NEVER be modified directly by customers — only by trusted server verification.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderStatus', 'updatedAt']) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderStatus', 'inventoryRestored', 'updatedAt'])
          ) &&
          request.resource.data.status == 'Cancelled' &&
          request.resource.data.orderStatus == 'Cancelled'
        )
      );
      allow delete: if isAdmin();
    }

    // 3. Products collection:
    // Publicly readable. Admin has full write access.
    // Authenticated customers can decrement stock & inStock when an order is placed.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock']);
    }

    // 4. Coupons collection:
    // Publicly readable for checkout validation. Admin only for creation/editing.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Teaware collection:
    // Publicly readable. Admin has full write access.
    // Authenticated customers can decrement stock & inStock during checkout when purchased.
    match /teaware/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock']);
    }

    // 6. Hampers collection:
    // Publicly readable. Admin has full write access.
    // Authenticated customers can decrement stock & inStock during checkout.
    match /hampers/{hamperId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock']);
    }

    // 7. Reviews collection:
    // Publicly readable so customers can browse verified tasting notes.
    // Customers can submit their own reviews; Admins have full moderation/deletion rights.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin() || (
        request.resource.data.get('customerName', '') != ''
      );
      allow update, delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.get('userId', '') == request.auth.uid ||
          (resource.data.get('customerEmail', '') != '' && request.auth.token.email != null &&
           resource.data.customerEmail.lower() == request.auth.token.email.lower())
        )
      );
    }

    // 8. Newsletter Subscribers:
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 9. Gifting Requests:
    match /gifting_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 10. Contact Inquiries:
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 11. Firebase Trigger Email extension queue:
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 12. System metadata (catalog metadata for permanently deleted items):
    // Publicly readable so customer catalog knows deleted items. Admin has full write access.
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
