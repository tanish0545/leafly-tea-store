rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'leaflydatabase@gmail.com' ||
          request.auth.token.email.lower() == 'leaflydatabase@gmail.com' ||
          request.auth.token.email == 'admin@leafly.com' ||
          request.auth.token.email.lower() == 'admin@leafly.com' ||
          request.auth.token.email == 'admin@leaflytea.com' ||
          request.auth.token.email.lower() == 'admin@leaflytea.com'
        )) ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('isAdmin', false) == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ))
      );
    }

    // 1. Users collection:
    // Authenticated users can read and write only their own document.
    // Authorized Admins can read all customer accounts.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Orders collection:
    // Customers can only create orders that correspond to their authenticated identity.
    // Customers can read their own orders and cancel them.
    // Authorized Admins have full access.
    match /orders/{orderId} {
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.customerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerId == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email
        ) && (
          // Customer can only update status/cancellation fields
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderStatus', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // 3. Products collection:
    // Publicly readable. Admin has full write access.
    // Authenticated customers can decrement stock & inStock when an order is placed.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock']);
    }

    // 4. Coupons collection:
    // Publicly readable for checkout validation. Admin only for creation/editing.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Teaware collection:
    // Publicly readable. Admin has full write access.
    // Authenticated customers can decrement stock & inStock during checkout when purchased.
    match /teaware/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock']);
    }

    // 6. Hampers collection:
    // Publicly readable. Admin has full write access.
    // Authenticated customers can decrement stock & inStock during checkout.
    match /hampers/{hamperId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'inStock']);
    }

    // 7. Reviews collection:
    // Publicly readable. Customers can submit reviews. Admins can moderate/delete.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 8. Newsletter Subscribers:
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 9. Gifting Requests:
    match /gifting_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 10. Contact Inquiries:
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 11. Firebase Trigger Email extension queue:
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
